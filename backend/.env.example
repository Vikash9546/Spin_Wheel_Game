# Database Connection URL (PostgreSQL)
# For Supabase, Neon, Render, or a local PostgreSQL instance
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/postgres?schema=public"

# Redis Connection URL
# For local development, e.g., "redis://127.0.0.1:6379"
# For production (Upstash/Render), e.g., "rediss://default:your_token@your_host:6379"
REDIS_URL="redis://127.0.0.1:6379"

# Express Server Port
PORT=3000

# JSON Web Token Secret (used for signing and verifying player auth tokens)
JWT_SECRET="change_me_to_a_secure_random_string_in_production"

# Node Environment (development | production)
NODE_ENV="development"
